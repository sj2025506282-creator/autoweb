{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/:path*",
        "destination": "http://localhost:8787/api/:path*",
        "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/restaurants/[id]",
      "regex": "^/restaurants/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/restaurants/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/restaurants/[id]/analytics",
      "regex": "^/restaurants/([^/]+?)/analytics(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/restaurants/(?<nxtPid>[^/]+?)/analytics(?:/)?$"
    },
    {
      "page": "/restaurants/[id]/menu",
      "regex": "^/restaurants/([^/]+?)/menu(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/restaurants/(?<nxtPid>[^/]+?)/menu(?:/)?$"
    },
    {
      "page": "/restaurants/[id]/reservations",
      "regex": "^/restaurants/([^/]+?)/reservations(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/restaurants/(?<nxtPid>[^/]+?)/reservations(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/outreach",
      "regex": "^/outreach(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/outreach(?:/)?$"
    },
    {
      "page": "/outreach/review",
      "regex": "^/outreach/review(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/outreach/review(?:/)?$"
    },
    {
      "page": "/restaurants",
      "regex": "^/restaurants(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/restaurants(?:/)?$"
    },
    {
      "page": "/restaurants/new",
      "regex": "^/restaurants/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/restaurants/new(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/site",
      "regex": "^/site(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/site(?:/)?$"
    },
    {
      "page": "/site/contact",
      "regex": "^/site/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/site/contact(?:/)?$"
    },
    {
      "page": "/site/menu",
      "regex": "^/site/menu(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/site/menu(?:/)?$"
    },
    {
      "page": "/site/reserve",
      "regex": "^/site/reserve(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/site/reserve(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/templates",
      "regex": "^/templates(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/templates(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}