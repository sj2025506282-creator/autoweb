{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autoweb-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "autoweb.animalmusicstudio.com",
      "custom_domain": true
    },
    {
      "pattern": "*.autoweb.animalmusicstudio.com/*",
      "zone_name": "animalmusicstudio.com"
    }
  ],
  "vars": {
    "API_BASE_URL": "https://api.autoweb.animalmusicstudio.com",
    "MAIN_DOMAIN": "autoweb.animalmusicstudio.com",
    "NEXT_PUBLIC_MAIN_DOMAIN": "autoweb.animalmusicstudio.com",
    "NEXT_PUBLIC_BASE_URL": "https://autoweb.animalmusicstudio.com"
  },
  "services": [
    {
      "binding": "API",
      "service": "autoweb-api"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
